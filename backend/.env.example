PORT=5000

# Main cluster URI (residents, reports, notifications)
# Database name defaults to "test" if not in the URI path
MONGODB_URI=mongodb://localhost:27017/?authSource=admin
MONGODB_DB_NAME=test
# Admin accounts (separate from MongoDB's built-in `admin` auth database)
MONGODB_ADMIN_DB_NAME=tt_admin
# Cleaning crew are stored in the "c_c" database
MONGODB_URI_CREW=mongodb://localhost:27017/c_c?authSource=admin

CLIENT_URL=http://localhost:5174
# For phone testing on the same Wi‑Fi:
# CLIENT_URL=http://192.168.x.x:5174
# For ngrok (mobile data / anywhere) — paste the https URL from `npm run tunnel`:
# CLIENT_URL=https://your-subdomain.ngrok-free.app
JWT_SECRET=change_me_in_production

# --- SMTP (required for password-reset emails) ---
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your.email@gmail.com

# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
# Yahoo:   SMTP_HOST=smtp.mail.yahoo.com    SMTP_PORT=587
